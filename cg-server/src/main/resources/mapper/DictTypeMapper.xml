<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="icu.binglieyan.mapper.DictTypeMapper">

    <select id="pageQuery" resultType="icu.binglieyan.vo.DictTypePageQueryVO">
        select
        d.type_code,
        d.type_name,
        d.description,
        d.is_system as `system`
        from dict_type d
        <where>
            <if test="dictTypePageQueryDTO.typeCode != null and dictTypePageQueryDTO.typeCode != ''">
                and d.type_code like concat('%',#{dictTypePageQueryDTO.typeCode},'%')
            </if>
            <if test="dictTypePageQueryDTO.typeName != null and dictTypePageQueryDTO.typeName != ''">
                and d.type_name like concat('%',#{dictTypePageQueryDTO.typeName},'%')
            </if>
            <if test="dictTypePageQueryDTO.system != null">
                and d.is_system = #{dictTypePageQueryDTO.system}
            </if>
        </where>
    </select>
</mapper>
